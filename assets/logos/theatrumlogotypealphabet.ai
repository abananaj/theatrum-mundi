         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Alphabet in medieval gothic style. Set of dim colored emblems. Engraved initial drop caps. Perfect for vintage premium identity, Middle Ages posters, luxury packaging.</rdf:li>
            </rdf:Alt>
